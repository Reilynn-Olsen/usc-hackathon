AISSTREAM_API_KEY=your_aisstream_api_key
TYPESAFE_API_KEY=your_typesafe_api_key

# Optional API root for separately running Jev container. Use its published
# host port with host.docker.internal when running this app through Compose.
# TYPESAFE_BASE_URL=http://host.docker.internal:YOUR_JEV_PORT

# Set true for deterministic local mock decisions; ignored in production.
JEV_MOCK=false
